<Project>
    <PropertyGroup>
        <PrepareForBuildDependsOn>$(PrepareForBuildDependsOn);_SlangReferences</PrepareForBuildDependsOn>
        <DefineConstants Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND
		                            ($([MSBuild]::VersionGreaterThanOrEquals($(_TargetFrameworkVersionWithoutV), '7.0')) OR
									($([MSBuild]::VersionGreaterThanOrEquals($(_TargetFrameworkVersionWithoutV), '6.0')) AND '$(LangVersion)'=='preview'))">$(DefineConstants);GENERIC_ATTRIBUTES</DefineConstants>
    </PropertyGroup>
    <Target Name="_SlangMultiTargetRoslyn3"
            Condition="'$(SupportsRoslynComponentVersioning)' != 'true'"
            AfterTargets="ResolvePackageDependenciesForBuild;ResolveNuGetPackageAssets"
            BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)"
                           Condition="$([System.String]::Copy('%(Analyzer.Identity)').IndexOf('Slang.Net.dll')) &gt;= 0"/>
        </ItemGroup>
    </Target>
    <Target Name="_SlangReferences" DependsOnTargets="ResolvePackageAssets">
        <PropertyGroup>
            <_SlangAttributesReferenced
                Condition="@(PackageDependencies->WithMetadataValue('Identity', 'Slang.Attributes')->Count()) != 0">true</_SlangAttributesReferenced>
            <DefineConstants Condition="'$(_SlangAttributesReferenced)' == 'true'">$(DefineConstants);SLANG_ATTRIBUTES_REFERENCED</DefineConstants>
        </PropertyGroup>
    </Target>
</Project>
