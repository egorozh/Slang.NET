<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>

        <Version>9.9.0</Version>
        <Version Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</Version>
        <PackageId>Slang.Net</PackageId>

        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Slang.Generator\Slang.Generator.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- The generator and its dependency closure are bundled as analyzers.
         netstandard2.0 keeps the package loadable in every compiler host, including Visual Studio.
         Roslyn assemblies (Microsoft.CodeAnalysis.*, System.Collections.Immutable, System.Reflection.Metadata)
         are provided by the host and must not be packed. -->
    <ItemGroup Label="Package">
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\Slang.Generator.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\Slang.Generator.Core.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\Slang.Shared.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Text.Json.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Text.Encodings.Web.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Buffers.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Memory.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Numerics.Vectors.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Runtime.CompilerServices.Unsafe.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\System.Threading.Tasks.Extensions.dll" />
        <_GeneratorOutput Include="..\Slang.Generator\bin\$(Configuration)\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll" />

        <None Include="@(_GeneratorOutput)" PackagePath="analyzers\dotnet\cs" Pack="true" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="PluralResolverMap.cs">
            <DependentUpon>Pluralization.cs</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" Visible="false" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" Visible="false" PackagePath="" />
    </ItemGroup>

</Project>
